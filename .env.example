# Credenciais da área restrita
ADMIN_EMAIL=equipe@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
# O projeto Vercel atual usa AUTH_SECRET; SESSION_SECRET também é aceito.
AUTH_SECRET=gere-uma-string-aleatoria-com-mais-de-32-caracteres
# SESSION_SECRET=gere-uma-string-aleatoria-com-mais-de-32-caracteres

# Vercel Blob — criado e conectado ao projeto pelo painel Storage
# Use BLOB_READ_WRITE_TOKEN ou a combinação BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Bolten CRM integration (optional; configure directly in Vercel)
BOLTEN_API_KEY=
BOLTEN_PROJECT_ID=
# Optional override for testing or provider changes
BOLTEN_API_BASE_URL=https://app.bolten.io/kanban/api/v1

# OpenRouter — análise estratégica por IA (opcional)
# Crie a chave em https://openrouter.ai/keys e nunca a publique no GitHub.
OPENROUTER_API_KEY=
# Roteador gratuito; ele escolhe um modelo free disponível.
OPENROUTER_MODEL=openrouter/free
# Opcional: URL pública do site para identificação da aplicação.
OPENROUTER_SITE_URL=https://basemidia.vercel.app
# Opcional: default https://openrouter.ai/api/v1
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
